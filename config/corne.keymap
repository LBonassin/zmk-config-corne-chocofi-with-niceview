#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen { zmk,matrix_transform = &five_column_transform; };
};

&lt {
    tapping-term-ms = <140>; // Default is 200ms; decrease for faster layer activation
};

&mt {
    tapping-term-ms = <160>;
    flavor = "tap-preferred";
};

/ {
    combos {
        compatible = "zmk,combos";

        // Tab / Shift+Tab

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
            layers = <0 1 2 3 4 5>;
            timeout-ms = <30>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <0 1 32>;
            layers = <0 1 2 3 4 5>;
        };

        // Shift

        shift2 {
            bindings = <&sk LSHFT>;
            key-positions = <10 11>;
            layers = <0 1 2 3 4 5>;
            timeout-ms = <20>;
        };

        shift_enter2 {
            bindings = <&mt RIGHT_SHIFT ENTER>;
            key-positions = <18 19>;
            layers = <0 1 2 3 4 5>;
            timeout-ms = <20>;
        };

        // Ctrl

        ctrl2 {
            bindings = <&sk LCTRL>;
            key-positions = <11 12>;
            layers = <0 1 2 3 4 5>;
            timeout-ms = <25>;
        };

        r_ctrl2 {
            bindings = <&sk RCTRL>;
            key-positions = <18 17>;
            layers = <0 1 2 3 4 5>;
            timeout-ms = <18>;
        };

        // Win

        win2 {
            bindings = <&sk LEFT_WIN>;
            key-positions = <12 13>;
            layers = <0 1 2 3 4 5>;
            timeout-ms = <25>;
        };

        r_win2 {
            bindings = <&sk LEFT_WIN>;
            key-positions = <16 17>;
            layers = <0 1 2 3 4 5>;
            timeout-ms = <25>;
        };

        // Shift+Ctrl

        ls_ctrl2 {
            bindings = <&sk LC(LEFT_SHIFT)>;
            key-positions = <10 11 12>;
            layers = <0 1 2 3 4 5>;
        };

        r_ctrl_shift2 {
            bindings = <&sk RC(RIGHT_SHIFT)>;
            key-positions = <19 18 17>;
            layers = <0 1 2 3 4 5>;
        };

        // Ctrl+Win

        l_ctrl_win2 {
            bindings = <&sk LC(LEFT_WIN)>;
            key-positions = <11 12 13>;
            layers = <0 1 2 3 4 5>;
        };

        r_win_ctrl2 {
            bindings = <&sk LC(LEFT_WIN)>;
            key-positions = <18 17 16>;
            layers = <0 1 2 3 4 5>;
        };

        // Shift+Win

        win_shift2 {
            bindings = <&sk LS(LEFT_WIN)>;
            key-positions = <10 13>;
            layers = <0 1 2 3 4 5>;
            timeout-ms = <25>;
        };

        r_shift_win2 {
            bindings = <&sk LS(LEFT_WIN)>;
            key-positions = <16 19>;
            layers = <0 1 2 3 4 5>;
            timeout-ms = <25>;
        };

        // Ctrl (hold)

        ctrl_two {
            bindings = <&kp LCTRL>;
            key-positions = <20 32>;
            layers = <0 1 2 3 4 5>;
            timeout-ms = <70>;
        };

        r_ctrl_two {
            bindings = <&kp RCTRL>;
            key-positions = <29 33>;
            layers = <0 1 2 3 4 5>;
            timeout-ms = <70>;
        };

        // Shift (hold)

        l_game_shift {
            bindings = <&kp LSHFT>;
            key-positions = <10 32>;
            timeout-ms = <65>;
            layers = <0 1 2 3 4 5>;
        };

        r_game_shift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <19 33>;
            layers = <0 1 2 3 4 5>;
        };

        // Unpaired

        instant_win {
            bindings = <&kp LEFT_WIN>;
            key-positions = <24 23>;
            layers = <0 1 2 3 4 5>;
            timeout-ms = <25>;
        };

        esc_two {
            bindings = <&kp ESCAPE>;
            key-positions = <32 12>;
            layers = <0 1 2 3 4 5>;
            timeout-ms = <25>;
        };

        printscreen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <24 23 32>;
            layers = <0 1 2>;
        };

        record {
            bindings = <&kp LG(LA(G))>;
            key-positions = <22 23 24 32>;
            layers = <0 1 2>;
        };

        winAltPrintscreen {
            bindings = <&kp LG(LA(PRINTSCREEN))>;
            key-positions = <24 23 32>;
            layers = <4>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <24 32>;
            timeout-ms = <65>;
            layers = <0>;
        };
    };

    behaviors {
        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <80>;
            bindings = <&shifted>, <&kp>;
        };

        volume_updown: volume_updown {
            compatible = "zmk,behavior-tap-dance";
            label = "VOLUME_UPDOWN";
            #binding-cells = <0>;
            bindings = <&kp C_VOLUME_UP>, <&kp C_VOLUME_DOWN>;
        };

        magic: magic {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&key_repeat>;

            spc_the {
                trigger-keys = <SPACE>;
                bindings = <&macro_the>;
            };
        };

        magic_y: magic_y {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp Y>;

            spc_the {
                trigger-keys = <SPACE>;
                bindings = <&macro_the>;
            };
        };

        //needs to be after magic declaration

        hold_layer_tap_magic: hold_layer_tap_magic {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&mo>, <&magic>;
        };

        hold_shift_tap_magic_y: hold_shift_tap_magic_y {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&kp>, <&magic_y>;
        };
    };

    macros {
        shifted: macro_shifted_kp {
            #binding-cells = <1>;
            label = "MACRO_SHIFTED_KP";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&kp LSHFT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "AUTOSHIFT_KP";
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };

        to_first: to_first {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&kp LC(LA(F13)) &to 0>;
        };

        to_second: to_second {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&kp LC(LA(F14)) &to 1>;
        };

        to_third: to_third {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&kp LC(LA(F15)) &to 2>;
        };

        macro_the: macro_the {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp SPACE>;
        };

        macro_ph: macro_ph {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H>;
        };

        macro_ky: macro_ky {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y>;
        };

        macro_eu: macro_eu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp U>;
        };

        macro_fy: macro_fy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y>;
        };

        macro_gs: macro_gs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S>;
        };

        macro_hy: macro_hy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y>;
        };

        macro_oa: macro_oa {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A>;
        };

        macro_rl: macro_rl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L>;
        };

        macro_sc: macro_sc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C>;
        };

        macro_cs: macro_cs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S>;
        };

        macro_pl: macro_pl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L>;
        };

        macro_ue: macro_ue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E>;
        };

        macro_ws: macro_ws {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S>;
        };

        macro_yapos: macro_yapos {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp APOS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        graphite {
            label = "graphite";
            bindings = <
  &kp B             &kp L  &kp D         &kp W  &kp Z               &as APOS           &kp F            &kp O       &kp U    &kp J
  &mt LEFT_SHIFT N  &kp R  &kp T         &kp S  &mt LEFT_SHIFT G    &mt RIGHT_SHIFT Y  &kp H            &kp A       &kp E    &mt RIGHT_SHIFT I
  &mt LCTRL Q       &kp X  &kp M         &kp C  &kp V               &kp K              &kp P            &as COMMA   &as DOT  &as APOS
                           &kp LEFT_ALT  &mo 3  &kp SPACE           &mt ENTER R        &lt 4 BACKSPACE  &kp DELETE
            >;
        };

        HDP {
            label = "HDP";
            bindings = <
  &kp V             &kp W  &kp G         &kp M    &kp J               &kp Z              &kp PERIOD       &as COMMA   &as FSLH  &as SEMI
  &mt LEFT_SHIFT S  &kp N  &kp T         &kp H    &mt LEFT_SHIFT K    &mt RIGHT_SHIFT Q  &kp A            &kp E       &kp I     &mt RIGHT_SHIFT C
  &mt LCTRL F       &kp P  &kp D         &kp L    &kp X               &as APOS           &kp U            &kp O       &kp Y     &kp B
                           &kp LEFT_ALT  &lt 3 R  &kp SPACE           &mt ENTER R        &lt 4 BACKSPACE  &kp DELETE
            >;
        };

        qwerty {
            label = "qwerty";
            bindings = <
  &as Q  &as W  &as E         &as R  &as T        &as Y      &as U            &as I      &as O    &as P
  &as A  &as S  &as D         &as F  &as G        &as H      &as J            &as K      &as L    &as SEMI
  &as Z  &as X  &as C         &as V  &as B        &as N      &as M            &as COMMA  &as DOT  &as FSLH
                &kp LEFT_ALT  &mo 3  &kp SPACE    &mt ENTER R   &lt 4 BACKSPACE  &kp DEL
            >;
        };

        f_keys {
            label = "f_keys";
            bindings = <
  &kp F1  &kp F2   &kp F3   &kp F4   &as GRAVE         &kp C_VOLUME_UP    &caps_word  &none         &kp CAPSLOCK   &kp BACKSPACE
  &kp F5  &kp F6   &kp F7   &kp F8   &volume_updown    &kp C_VOLUME_DOWN  &kp DEL     &kp UP_ARROW  &kp BACKSPACE  &as SEMI
  &kp F9  &kp F10  &kp F11  &kp F12  &sk LSHIFT        &none              &kp LEFT    &kp DOWN      &kp RIGHT      &none
                   &trans   &trans   &kp DEL           &trans             &mo 5       &trans
            >;
        };

        math {
            label = "math";
            bindings = <
  &kp EXCLAMATION       &kp QUESTION           &kp SEMI          &kp COLON          &kp UNDERSCORE    &none            &as NUMBER_7  &as NUMBER_8  &as NUMBER_9  &kp BACKSPACE
  &kp ASTERISK          &kp SLASH              &kp PLUS          &kp MINUS          &as MINUS         &as EQUAL        &as NUMBER_4  &as NUMBER_5  &as NUMBER_6  &as BACKSLASH
  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &as LEFT_BRACKET  &as RIGHT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE  &as NUMBER_1  &as NUMBER_2  &as NUMBER_3  &kp PERIOD
                                               &trans            &lt 5 BACKSPACE    &kp NUMBER_0      &trans           &trans        &kp NUMBER_0
            >;
        };

        bt {
            label = "bt";
            bindings = <
  &trans  &trans      &bt BT_SEL 0  &trans      &trans    &trans  &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &trans
  &trans  &bt BT_PRV  &bt BT_SEL 1  &bt BT_NXT  &trans    &trans  &kp INSERT       &kp HOME        &kp PAGE_UP      &trans
  &trans  &to_first   &to_second    &to_third   &trans    &trans  &kp DELETE       &kp END         &kp PAGE_DOWN    &bt BT_CLR
                      &trans        &trans      &trans    &trans  &trans           &trans
            >;
        };
    };
};
