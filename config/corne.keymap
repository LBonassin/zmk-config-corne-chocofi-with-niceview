#define ZMK_POINTING_DEFAULT_MOVE_VAL 2500  // default is 600

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,matrix_transform = &five_column_transform; };
};

&lt {
    tapping-term-ms = <140>; // Default is 200ms; decrease for faster layer activation
};

&mt {
    tapping-term-ms = <150>;
    flavor = "tap-preferred";
};

/ {
    combos {
        compatible = "zmk,combos";

        // Tab / Shift+Tab

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
            layers = <0 1 3 4 5>;
            timeout-ms = <30>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <0 1 32>;
            layers = <0 1 3 4 5>;
        };

        // Shift
        // Ctrl

        ctrl2 {
            bindings = <&sk LCTRL>;
            key-positions = <11 12>;
            layers = <0 1 3 4 5>;
            timeout-ms = <18>;
            require-prior-idle-ms = <200>;
        };

        r_ctrl2 {
            bindings = <&sk RCTRL>;
            key-positions = <18 17>;
            layers = <0 1 3 4 5>;
            timeout-ms = <17>;
            require-prior-idle-ms = <500>;
        };

        // Win

        win2 {
            bindings = <&sk LEFT_WIN>;
            key-positions = <12 13>;
            layers = <0 1 3 4 5>;
            timeout-ms = <18>;
            require-prior-idle-ms = <200>;
        };

        // Shift+Ctrl

        ls_ctrl2 {
            bindings = <&sk LC(LEFT_SHIFT)>;
            key-positions = <10 11 12>;
            layers = <0 1 3 4 5>;
            timeout-ms = <25>;
            require-prior-idle-ms = <25>;
        };

        r_ctrl_shift2 {
            bindings = <&sk RC(RIGHT_SHIFT)>;
            key-positions = <19 18 17>;
            layers = <0 1 3 4 5>;
            timeout-ms = <25>;
            require-prior-idle-ms = <200>;
        };

        // Ctrl+Win

        l_ctrl_win2 {
            bindings = <&sk LC(LEFT_WIN)>;
            key-positions = <11 12 13>;
            layers = <0 1 3 4 5>;
            timeout-ms = <25>;
            require-prior-idle-ms = <200>;
        };

        r_win_ctrl2 {
            bindings = <&sk LC(LEFT_WIN)>;
            key-positions = <18 17 16>;
            layers = <0 1 3 4 5>;
            timeout-ms = <25>;
            require-prior-idle-ms = <200>;
        };

        // Shift+Win

        win_shift2 {
            bindings = <&sk LS(LEFT_WIN)>;
            key-positions = <10 13>;
            layers = <0 1 3 4 5>;
            timeout-ms = <25>;
            require-prior-idle-ms = <200>;
        };

        // Ctrl (hold)

        ctrl_two {
            bindings = <&kp LCTRL>;
            key-positions = <20 32>;
            layers = <0 1 3 4 5>;
            timeout-ms = <50>;
        };

        r_ctrl_two {
            bindings = <&kp RCTRL>;
            key-positions = <29 33>;
            layers = <0 1 3 4 5>;
            timeout-ms = <70>;
        };

        // Shift (hold)

        l_game_shift {
            bindings = <&kp LSHFT>;
            key-positions = <10 32>;
            timeout-ms = <50>;
            layers = <0 1 3 4 5>;
        };

        r_game_shift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <19 33>;
            layers = <0 1 3 4 5>;
            timeout-ms = <50>;
        };

        // Unpaired

        instant_win {
            bindings = <&kp LEFT_WIN>;
            key-positions = <24 23>;
            layers = <0 1 3 4 5>;
            timeout-ms = <25>;
            require-prior-idle-ms = <200>;
        };

        esc_two {
            bindings = <&kp ESCAPE>;
            key-positions = <32 12>;
            layers = <0 1 3 4 5>;
            timeout-ms = <25>;
            require-prior-idle-ms = <25>;
        };

        printscreen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <24 23 32>;
            layers = <0 1>;
        };

        record {
            bindings = <&kp LG(LA(G))>;
            key-positions = <22 23 24 32>;
            layers = <0 1>;
        };

        winAltPrintscreen {
            bindings = <&kp LG(LA(PRINTSCREEN))>;
            key-positions = <24 23 32>;
            layers = <4>;
        };

        enter1 {
            bindings = <&kp ENTER>;
            key-positions = <24 32>;
            timeout-ms = <25>;
            layers = <0 1>;
            require-prior-idle-ms = <25>;
        };

        shift_alt {
            bindings = <&kp LS(LEFT_ALT)>;
            key-positions = <30 10>;
            layers = <0 1>;
        };

        ctrl_alt {
            bindings = <&kp LC(LEFT_ALT)>;
            key-positions = <20 30>;
            layers = <0 1>;
        };

        q {
            bindings = <&kp Q>;
            key-positions = <22 23>;
            layers = <0>;
            timeout-ms = <25>;
        };

        z {
            bindings = <&kp Z>;
            key-positions = <21 22>;
            layers = <0>;
            timeout-ms = <30>;
        };

        qu {
            bindings = <&qu>;
            key-positions = <21 23>;
            layers = <0>;
            timeout-ms = <30>;
        };

        qu2 {
            bindings = <&qu>;
            key-positions = <11 13>;
            timeout-ms = <20>;
            layers = <0>;
        };

        to_xcvz {
            bindings = <&sl 6>;
            key-positions = <10 31>;
            layers = <0>;
            timeout-ms = <25>;
            require-prior-idle-ms = <25>;
        };

        to_mouse {
            bindings = <&tog 2>;
            key-positions = <34 35>;
            layers = <0 1 2>;
        };

        enter2 {
            bindings = <&kp ENTER>;
            key-positions = <33 25>;
            layers = <0 1>;
            timeout-ms = <25>;
        };

        enter3 {
            bindings = <&kp ENTER>;
            key-positions = <33 17>;
            layers = <0 1>;
            timeout-ms = <25>;
        };
    };

    behaviors {
        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <80>;
            bindings = <&shifted>, <&kp>;
        };

        volume_updown: volume_updown {
            compatible = "zmk,behavior-tap-dance";
            label = "VOLUME_UPDOWN";
            #binding-cells = <0>;
            bindings = <&kp C_VOLUME_UP>, <&kp C_VOLUME_DOWN>;
        };

        lt_200: lt_200 {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_200";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };

        magic: magic {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&key_repeat>;

            y_apos {
                trigger-keys = <Y>;
                bindings = <&macro_yapos>;
            };

            i_apos {
                trigger-keys = <I>;
                bindings = <&macro_iapos>;
            };

            spc_the {
                trigger-keys = <SPACE>;
                bindings = <&macro_the>;
            };

            s_c {
                trigger-keys = <S>;
                bindings = <&macro_sc>;
            };

            p_h {
                trigger-keys = <P>;
                bindings = <&macro_ph>;
            };

            k_y {
                trigger-keys = <K>;
                bindings = <&macro_ky>;
            };

            e_u {
                trigger-keys = <E>;
                bindings = <&macro_eu>;
            };

            f_y {
                trigger-keys = <F>;
                bindings = <&macro_fy>;
            };

            g_s {
                trigger-keys = <G>;
                bindings = <&macro_gs>;
            };

            h_y {
                trigger-keys = <H>;
                bindings = <&macro_hy>;
            };

            o_a {
                trigger-keys = <O>;
                bindings = <&macro_oa>;
            };

            r_l {
                trigger-keys = <R>;
                bindings = <&macro_rl>;
            };

            u_e {
                trigger-keys = <U>;
                bindings = <&macro_ue>;
            };

            w_s {
                trigger-keys = <W>;
                bindings = <&macro_ws>;
            };
        };

        hold_layer_tap_magic: hold_layer_tap_magic {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&mo>, <&magic>;
        };
    };

    macros {
        shifted: macro_shifted_kp {
            #binding-cells = <1>;
            label = "MACRO_SHIFTED_KP";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&kp LSHFT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "AUTOSHIFT_KP";
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };

        to_first: to_first {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&kp LC(LA(F13)) &to 0>;
        };

        to_second: to_second {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&kp LC(LA(F14)) &to 0>;
        };

        qu: qu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp U>;
            label = "QU";
        };

        to_third: to_third {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&macro_tap>, <&kp LC(LA(F15)) &to 1>;

            label = "TO_THIRD";
        };

        macro_the: macro_the {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp SPACE>;
        };

        macro_ph: macro_ph {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H>;
        };

        macro_ky: macro_ky {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y>;
        };

        macro_eu: macro_eu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp U>;
        };

        macro_fy: macro_fy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y>;
        };

        macro_gs: macro_gs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S>;
        };

        macro_hy: macro_hy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y>;
        };

        macro_oa: macro_oa {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A>;
        };

        macro_rl: macro_rl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L>;
        };

        macro_sc: macro_sc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C>;
        };

        macro_cs: macro_cs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S>;
        };

        macro_pl: macro_pl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L>;
        };

        macro_ue: macro_ue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E>;
        };

        macro_ws: macro_ws {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S>;
        };

        macro_yapos: macro_yapos {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp APOS>;
        };

        macro_iapos: macro_iapos {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp APOS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        graphite {
            label = "graphite";
            bindings = <
  &kp B               &kp L  &kp D         &kp W                      &kp Z               &as SLASH              &kp F            &kp O       &kp U    &kp J
  &mt LEFT_SHIFT N    &kp R  &kp T         &kp S                      &mt LEFT_SHIFT G    &mt RIGHT_SHIFT Y      &kp H            &kp A       &kp E    &kp I
  &mt LEFT_CONTROL Q  &kp X  &kp M         &kp C                      &kp V               &kp K                  &kp P            &as COMMA   &as DOT  &as APOS
                             &kp LEFT_ALT  &hold_layer_tap_magic 3 0  &kp SPACE           &mt RIGHT_SHIFT SPACE  &lt 4 BACKSPACE  &kp DELETE
            >;
        };

        qwerty {
            label = "qwerty";
            bindings = <
  &kp Q             &kp W  &kp E         &kp R  &kp T               &kp Y                  &kp U            &kp I      &kp O    &kp P
  &mt LEFT_SHIFT A  &kp S  &kp D         &kp F  &mt LEFT_SHIFT G    &mt RIGHT_SHIFT H      &kp J            &kp K      &kp L    &as SEMI
  &mt LCTRL Z       &kp X  &kp C         &kp V  &kp B               &kp N                  &kp M            &as COMMA  &as DOT  &as FSLH
                           &kp LEFT_ALT  &mo 3  &kp SPACE           &mt RIGHT_SHIFT SPACE  &lt 4 BACKSPACE  &kp DEL
            >;
        };

        mouse {
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans          &trans           &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &mkp MB1        &mmv MOVE_UP    &mkp MB2         &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans
                  &trans  &trans  &trans    &trans  &trans          &trans
            >;

            label = "mouse";
        };

        f_keys {
            label = "f_keys";
            bindings = <
  &kp F1  &kp F2   &kp F3   &kp F4   &as GRAVE         &kp C_VOLUME_UP    &caps_word  &none         &kp CAPSLOCK   &kp BACKSPACE
  &kp F5  &kp F6   &kp F7   &kp F8   &volume_updown    &kp C_VOLUME_DOWN  &kp DEL     &kp UP_ARROW  &kp BACKSPACE  &as SEMI
  &kp F9  &kp F10  &kp F11  &kp F12  &sk LSHIFT        &none              &kp LEFT    &kp DOWN      &kp RIGHT      &none
                   &trans   &trans   &kp DEL           &trans             &mo 5       &trans
            >;
        };

        math {
            label = "math";
            bindings = <
  &kp EXCLAMATION       &kp QUESTION           &kp SEMI          &kp COLON          &kp UNDERSCORE    &none            &as NUMBER_7  &as NUMBER_8  &as NUMBER_9  &kp BACKSPACE
  &kp ASTERISK          &kp SLASH              &kp PLUS          &kp MINUS          &as MINUS         &as EQUAL        &as NUMBER_4  &as NUMBER_5  &as NUMBER_6  &as BACKSLASH
  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &as LEFT_BRACKET  &as RIGHT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE  &as NUMBER_1  &as NUMBER_2  &as NUMBER_3  &kp PERIOD
                                               &trans            &lt 5 BACKSPACE    &kp NUMBER_0      &trans           &trans        &kp NUMBER_0
            >;
        };

        bt {
            label = "bt";
            bindings = <
  &trans  &trans      &bt BT_SEL 0  &trans      &trans    &trans  &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &trans
  &trans  &bt BT_PRV  &bt BT_SEL 1  &bt BT_NXT  &trans    &trans  &kp INSERT       &kp HOME        &kp PAGE_UP      &trans
  &trans  &to_first   &to_second    &to_third   &trans    &trans  &kp DELETE       &kp END         &kp PAGE_DOWN    &bt BT_CLR
                      &trans        &trans      &trans    &trans  &trans           &trans
            >;
        };

        xcvz {
            bindings = <
  &trans  &trans     &kp LC(A)  &trans     &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &kp LC(X)  &kp LC(C)  &kp LC(Z)  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans     &trans     &kp LC(V)  &trans    &trans  &trans  &trans  &trans  &trans
                     &trans     &trans     &trans    &trans  &trans  &trans
            >;

            label = "xcvz";
        };
    };
};
